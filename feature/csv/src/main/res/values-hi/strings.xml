    <string name="import_failed_unreadable">यह फ़ाइल पढ़ी नहीं जा सकी। देखें कि यह CSV फ़ाइल है, फिर कोशिश करें।</string>
    <string name="import_failed_empty">इस फ़ाइल में इम्पोर्ट करने के लिए कोई पंक्ति नहीं है। इसमें एक हेडर पंक्ति और कम से कम एक लेन-देन होना चाहिए।</string>
    <string name="import_failed_save">लेन-देन सहेजे नहीं जा सके। कुछ भी इम्पोर्ट नहीं हुआ।</string>
