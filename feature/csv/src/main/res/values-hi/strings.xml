    <!-- Import -->
    <string name="import_title">CSV से इम्पोर्ट करें</string>
    <string name="import_intro">CSV फ़ाइल से लेन-देन जोड़ें: Khata का एक्सपोर्ट, या कॉलम मिलाने के बाद कोई भी स्प्रेडशीट या बैंक स्टेटमेंट। पहले आपको झलक दिखेगी, और जो लेन-देन पहले से सहेजे हैं वे छोड़ दिए जाएँगे।</string>
    <string name="import_choose_file">CSV फ़ाइल चुनें</string>
