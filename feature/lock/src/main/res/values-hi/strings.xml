    <string name="lock_recovery_title">अपना रिकवरी कोड डालें</string>
    <string name="lock_recovery_body">16 अक्षरों का वह कोड जो आपने PIN बनाते समय सहेजा था।</string>
    <string name="lock_recovery_label">रिकवरी कोड</string>
    <string name="lock_back_to_pin">PIN पर वापस जाएँ</string>

    <string name="lock_no_screen_lock_title">आपके फ़ोन में स्क्रीन लॉक नहीं है</string>
    <string name="lock_no_screen_lock_body">Khata आम तौर पर आपके फ़ोन के फ़िंगरप्रिंट, चेहरे, PIN या पैटर्न से खुलता है। स्क्रीन लॉक के बिना, आपका फ़ोन हाथ में लेने वाला कोई भी आपके रिकॉर्ड खोल सकता है।</string>
    <string name="lock_set_screen_lock">स्क्रीन लॉक लगाएँ</string>
    <string name="lock_use_app_pin">इसके बजाय ऐप PIN इस्तेमाल करें</string>
    <string name="lock_continue_without">बिना लॉक के आगे बढ़ें</string>

    <string name="pin_setup_title">ऐप PIN चुनें</string>
    <string name="pin_setup_body">%1$d से %2$d अंक। Khata लॉक होने पर हर बार आप इसे डालेंगे।</string>
    <string name="pin_setup_confirm_title">PIN फिर से डालें</string>
    <string name="pin_setup_mismatch">दोनों PIN मेल नहीं खाए। फिर कोशिश करें।</string>

    <string name="recovery_code_title">अपना रिकवरी कोड सहेजें</string>
    <string name="recovery_code_body">अगर आप अपना PIN भूल जाएँ, तो यही कोड वापस आने का एकमात्र तरीका है। इसे लिखकर किसी सुरक्षित जगह रखें। यह सिर्फ़ एक बार दिखाया जाएगा।</string>
    <string name="recovery_code_saved">मैंने इसे लिख लिया है</string>
    <string name="recovery_code_done">हो गया</string>

    <string name="settings_lock_method">अनलॉक करें</string>
    <string name="settings_lock_method_device">फ़ोन का स्क्रीन लॉक</string>
    <string name="settings_lock_method_device_none">फ़ोन का स्क्रीन लॉक (आपके फ़ोन में नहीं है, इसलिए Khata लॉक नहीं है)</string>
    <string name="settings_lock_method_pin">ऐप PIN</string>
