    <string name="timeout_5m">बैकग्राउंड में 5 मिनट बाद</string>
    <string name="settings_remove_pin_title">ऐप PIN इस्तेमाल करना बंद करें?</string>
    <string name="settings_remove_pin_body">Khata इसके बजाय आपके फ़ोन के स्क्रीन लॉक से अनलॉक होगा। आपका PIN और रिकवरी कोड मिटा दिए जाएँगे।</string>
    <string name="settings_remove_pin_confirm">फ़ोन लॉक इस्तेमाल करें</string>
